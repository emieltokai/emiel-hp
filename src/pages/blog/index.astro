---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

const allPosts = await getCollection('blog');
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BlogLayout
  title="ブログ｜児童発達支援エミエル"
  description="エミエルスタッフが発達支援・療育・日々の活動について発信するブログです。"
>

  <section class="blog-hero">
    <div class="hero-inner">
      <p class="hero-badge">✏️ STAFF BLOG</p>
      <h1 class="hero-title">スタッフブログ</h1>
      <p class="hero-sub">発達支援・療育・日々の活動をスタッフがお届けします</p>
    </div>
    <div class="hero-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
        <path d="M0,20 C480,60 960,0 1440,40 L1440,60 L0,60 Z" fill="#fff"/>
      </svg>
    </div>
  </section>

  <section class="list-section">
    <div class="container">
      {posts.length === 0 ? (
        <p class="empty-msg">記事はまだありません。</p>
      ) : (
        <div class="blog-grid">
          {posts.map(post => (
            <article class="blog-card">
              {post.data.heroImage ? (
                <a href={`/blog/${post.id}`} class="card-img-wrap">
                  <img src={post.data.heroImage} alt={post.data.title} class="card-img" loading="lazy" />
                </a>
              ) : (
                <a href={`/blog/${post.id}`} class="card-img-wrap card-img-placeholder" aria-hidden="true">
                  <span>✏️</span>
                </a>
              )}
              <div class="card-body">
                {post.data.tags.length > 0 && (
                  <div class="card-tags">
                    {post.data.tags.map(tag => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
                <h2 class="card-title">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="card-desc">{post.data.description}</p>
                <div class="card-footer">
                  <time class="card-date" datetime={post.data.pubDate.toISOString()}>
                    📅 {formatDate(post.data.pubDate)}
                  </time>
                  <a href={`/blog/${post.id}`} class="card-link">続きを読む →</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

</BlogLayout>

<style>
  /* ===== HERO ===== */
  .blog-hero {
    background: linear-gradient(135deg, #ffe4ee, #fff7e0, #e8f8ff);
    padding: 72px 24px 0;
    text-align: center;
    position: relative;
  }
  .hero-inner { max-width: 700px; margin: 0 auto; padding-bottom: 60px; }
  .hero-badge {
    display: inline-block;
    background: rgba(255,107,138,0.12); color: #FF6B8A;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em;
    padding: 5px 16px; border-radius: 20px;
    margin-bottom: 18px;
  }
  .hero-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900; color: #333; margin-bottom: 14px;
  }
  .hero-sub { font-size: 0.95rem; color: #777; }
  .hero-wave { line-height: 0; }
  .hero-wave svg { display: block; width: 100%; height: 60px; }

  /* ===== LIST ===== */
  .list-section { padding: 60px 0 100px; background: #fff; }
  .container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .empty-msg { text-align: center; color: #999; font-size: 1rem; padding: 60px 0; }

  /* ===== GRID ===== */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  /* ===== CARD ===== */
  .blog-card {
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.07);
    overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform 0.25s, box-shadow 0.25s;
    border: 1px solid #f0f0f0;
  }
  .blog-card:hover { transform: translateY(-6px); box-shadow: 0 12px 32px rgba(0,0,0,0.11); }

  .card-img-wrap { display: block; overflow: hidden; height: 200px; }
  .card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .card-img-wrap:hover .card-img { transform: scale(1.04); }

  .card-img-placeholder {
    background: linear-gradient(135deg, #ffe4ee, #e8f8ff);
    display: flex; align-items: center; justify-content: center;
    font-size: 3rem;
  }

  .card-body { padding: 24px; flex: 1; display: flex; flex-direction: column; gap: 10px; }

  .card-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .tag {
    background: #FFE8ED; color: #FF6B8A;
    font-size: 0.72rem; font-weight: 700;
    padding: 3px 10px; border-radius: 20px;
  }

  .card-title { font-size: 1rem; font-weight: 800; color: #333; line-height: 1.5; margin: 0; }
  .card-title a { transition: color 0.2s; }
  .card-title a:hover { color: #FF6B8A; }

  .card-desc {
    font-size: 0.85rem; color: #666; line-height: 1.75; flex: 1;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }

  .card-footer {
    display: flex; align-items: center; justify-content: space-between;
    gap: 8px; margin-top: auto; padding-top: 4px;
  }
  .card-date { font-size: 0.78rem; color: #aaa; }
  .card-link { font-size: 0.82rem; font-weight: 700; color: #FF6B8A; transition: color 0.2s; white-space: nowrap; }
  .card-link:hover { color: #e05478; }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 900px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 580px) { .blog-grid { grid-template-columns: 1fr; } }
</style>
